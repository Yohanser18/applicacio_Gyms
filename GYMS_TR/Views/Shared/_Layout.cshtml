@*Aqui vamos autilizar algunas directivas para poder hacerde a las seciones*@
@using Microsoft.AspNetCore.Http
@*esto es para utilisar la siciones que ingresemos en el program y la carpeta de Utilidades*@
@inject IHttpContextAccessor HttpContextAccesor 
@using GYMS_TR_Utilidades


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GYMS_TR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GYMS_TR.styles.css" asp-append-version="true" />
    <link rel="stylesheet"  href="~/fontawesome/css/all.css"/>
    @*Estas son las libreria de terceros esta libreria son externas esto es todo todo lo que tiene que ver con los css*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/material.css" />

    <link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote.min.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                   <img src="~/imagenes/tile.png" width="40px" />  GYMS_TR
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between flex-row-reverse">
                    @*Aqui vamos agregar una vista parcial para que se muestre el todo lo que tiene que ver con el rister y login del usuario*@
                    <partial name="_LoginPartial"/>

                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link " asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @*Aqui estamos diciendo que nada mas pueden ver esta parte los que estan camroeles administrador*@
                        @if (User.IsInRole(WC.AdminRole))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Administral GYMS
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                    <li> <a class="dropdown-item " asp-area="" asp-controller="Categoria" asp-action="CategoriaIndex">Categoria</a> </li>
                                    <li> <a class="dropdown-item" asp-area="" asp-controller="TipoAplicacion" asp-action="TipoAplicacionIndex">Tipo Aplicacion</a> </li>
                                    <li> <a class="dropdown-item" asp-area="" asp-controller="Producto" asp-action="ProductoIndex">Pruducto</a> </li>
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Crear Nuevo Usuario</a></li>
                                </ul>
                            </li>
                        }
                        @*Aqui vamos hacer el proceso de ingresar los producto que seleccine el usuario ir guardandolo en el carro de compra// *@
                        <li>
                            @*Esto aqui lo que va hacer un conteo de los producto que tiene el usuario en le carro de compra*@
                            @if (HttpContextAccesor.HttpContext.Session.Get<List<CarroCompra>>(WC.SessionCarroCompras) != null)
                            {
                                @*Aqui estamos validadan el corro, que es donde mostraremos cuanto prodictos tenemos agregado*@
                                <a asp-action="CarroIndex" asp-controller="Carro" class="nav-link">
                                    @{
                                        var count = HttpContextAccesor.HttpContext.Session.Get<List<CarroCompra>>(WC.SessionCarroCompras).Count();
                                    }
                                    <i class="fas fa-shopping-cart"></i> &nbsp; (@count)
                                </a>
                            }
                            else
                            {
                             <a href="#" class="nav-link">
                                 <i class="fas fa-shopping-cart"></i> &nbsp; (0)
                             </a>
                            }
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-dark">
        <div class="container text-white">
            &copy; 2025 - GYMS_TR - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @*Estos son los Scripts de externos todo lo que tiene que tiene que ver con los funcionalidades de js*@
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/dist/ej2.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
